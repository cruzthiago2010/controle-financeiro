# Copie este arquivo para ".env" e preencha com seus valores.
# O ".env" nunca é enviado pro GitHub (está no .gitignore) — só o .env.example,
# que serve de modelo pra qualquer um saber quais variáveis o app aceita.
#
# Todas as variáveis abaixo são opcionais. Se você não criar o ".env" ou deixar
# alguma em branco, o app usa um valor padrão sensato sozinho (ver comentários).

# Usuário do primeiro login. Só tem efeito no primeiro start (antes de existir
# qualquer usuário no banco) — depois disso, mudar aqui não faz nada.
# Padrão se não definir: admin
ADMIN_USERNAME=admin

# Senha do primeiro login. Só tem efeito no primeiro start.
# Se deixar em branco, uma senha aleatória é gerada sozinha e aparece uma
# única vez no log (docker compose logs) — procure "USUÁRIO INICIAL CRIADO".
ADMIN_PASSWORD=escolha-uma-senha-forte

# Chave usada para assinar a sessão de login (cookie). Se deixar em branco,
# uma chave aleatória é gerada sozinha e salva em data/.secret_key na
# primeira vez que o app sobe.
SECRET_KEY=cole-aqui-uma-chave-aleatoria-longa-com-32-ou-mais-caracteres

# Login com Google (OAuth). Crie um "ID do cliente OAuth" do tipo "Aplicativo
# da Web" em console.cloud.google.com → APIs e Serviços → Credenciais.
# Sem essas duas variáveis, o botão "Entrar com Google" fica desativado —
# o app funciona normalmente só com usuário/senha.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Precisa ser cadastrado nos "URIs de redirecionamento autorizados" do
# Google, exatamente igual. Troque pelo SEU domínio — sem isso o login com
# Google fica desligado (o resto do app funciona normalmente).
GOOGLE_REDIRECT_URI=https://seu-dominio.com.br/api/auth/google/callback
