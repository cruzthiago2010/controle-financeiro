# Copie este arquivo para ".env" e preencha com seus valores.
# O ".env" nunca é enviado pro GitHub (está no .gitignore) — só o .env.example,
# que serve de modelo pra qualquer um saber quais variáveis o app aceita.
#
# Todas as variáveis abaixo são opcionais. Se você não criar o ".env" ou deixar
# alguma em branco, o app usa um valor padrão sensato sozinho (ver comentários).

# Usuário do primeiro login. Só tem efeito no primeiro start (antes de existir
# qualquer usuário no banco) — depois disso, mudar aqui não faz nada.
# Padrão se não definir: admin
ADMIN_USERNAME=admin

# Senha do primeiro login. Só tem efeito no primeiro start.
# Se deixar em branco, uma senha aleatória é gerada sozinha e aparece uma
# única vez no log (docker compose logs) — procure "USUÁRIO INICIAL CRIADO".
ADMIN_PASSWORD=escolha-uma-senha-forte

# Chave usada para assinar a sessão de login (cookie). Se deixar em branco,
# uma chave aleatória é gerada sozinha e salva em data/.secret_key na
# primeira vez que o app sobe.
SECRET_KEY=cole-aqui-uma-chave-aleatoria-longa-com-32-ou-mais-caracteres

# Login com Google (OAuth). Crie um "ID do cliente OAuth" do tipo "Aplicativo
# da Web" em console.cloud.google.com → APIs e Serviços → Credenciais.
# Sem essas duas variáveis, o botão "Entrar com Google" fica desativado —
# o app funciona normalmente só com usuário/senha.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Precisa ser cadastrado nos "URIs de redirecionamento autorizados" do
# Google, exatamente igual. Troque pelo SEU domínio — sem isso o login com
# Google fica desligado (o resto do app funciona normalmente).
GOOGLE_REDIRECT_URI=https://seu-dominio.com.br/api/auth/google/callback

# Token gratuito da brapi.dev (brapi.dev/dashboard), usado pra buscar sozinho
# a cotação de ações/FIIs/ETFs cadastrados na aba Investimentos. Sem essa
# variável, a cotação desses ativos não atualiza sozinha — o card mostra
# "cotação não configurada" e o resto do app funciona normalmente. Cripto e
# renda fixa não precisam dessa chave (usam CoinGecko e Banco Central, que
# são gratuitos e sem cadastro).
#
# O histórico de preço e o histórico de proventos NÃO dependem dessa chave:
# vêm do Yahoo Finance, que não pede cadastro. A única coisa que o token
# adiciona é a antecipação dos proventos que ainda vão cair ("A receber"),
# e mesmo assim só nos poucos tickers que o plano gratuito libera.
BRAPI_TOKEN=

# ---- Versão do app Android ----
# Qual versão do APK está publicada. Quem compara é o SERVIDOR: assim dá pra
# anunciar uma versão nova sem precisar publicar um APK novo só pra avisar que
# existe um APK novo. Dentro do app, quem estiver atrás vê um aviso com o link.
# Fora do app (navegador), o aviso nunca aparece.
APP_ANDROID_VERSAO=3.1

# Versão mínima aceitável. Quem estiver abaixo dela vê um aviso que NÃO pode ser
# dispensado — serve pra versão quebrada ou insegura. Deixe em branco pra
# desligar (o normal).
APP_ANDROID_MINIMA=

# Onde baixar o APK. Troque pelo SEU endereço: cada instalação publica o próprio
# app, e o padrão aponta pro repositório original.
APP_ANDROID_URL=https://github.com/financerto/financerto-app/releases/latest

# Uma frase curta sobre o que mudou, mostrada junto do aviso. Opcional.
APP_ANDROID_NOTAS=

# Repositorio de onde o APK e baixado. O GitHub e a fonte oficial, inclusive
# pro servidor de quem publica: uma fonte so evita duas versoes da verdade.
# O endereco do arquivo e montado como
#   https://github.com/<REPO>/releases/download/v<VERSAO>/FinanCerto-<VERSAO>.apk
# entao a release precisa ter esse nome de arquivo. Troque pelo SEU repositorio.
APP_ANDROID_REPO=financerto/financerto-app

# Se o seu APK nao estiver no GitHub, aponte o arquivo direto aqui. Precisa ser
# o ARQUIVO, nao a pagina: baixar a pagina traria HTML e o instalador do Android
# engasgaria com uma mensagem que nao explica nada.
APP_ANDROID_APK_URL=

# Endereco publico HTTPS deste servidor, para a Pluggy avisar na hora que chegou
# transacao nova (em vez de esperar o ciclo diario). A Pluggy recusa localhost.
# Deixe em branco pra desligar — o ciclo diario continua funcionando.
PLUGGY_WEBHOOK_URL=

# ---- Fuso horário ----

# Fuso do servidor. Decide a hora que o app grava (data de pagamento, horário
# do lançamento) e a hora que ele considera "agora" ao comparar vencimentos.
# Sem isto o container roda em UTC: no Brasil, marcar uma conta como paga às
# 22h grava a data do dia seguinte.
# Padrão se não definir: UTC
TZ=America/Sao_Paulo

# ---- Envio de e-mail (recuperação de senha) ----

# Todas opcionais. SEM SMTP configurado o recurso continua funcionando: o link
# de redefinição aparece no log do container (docker compose logs), e quem
# hospeda sozinho consegue voltar sem precisar de servidor de e-mail nenhum.
#
# Servidor SMTP. Em branco = envio desligado.
SMTP_HOST=

# Porta. 587 com STARTTLS (o mais comum) ou 465 com SSL.
# Padrão se não definir: 587
SMTP_PORTA=587

# starttls (padrão), ssl, ou nenhuma.
SMTP_SEGURANCA=starttls

# Usuário e senha do SMTP. Em branco, o app envia sem autenticar (só serve para
# relay interno). No Gmail, use uma "senha de app", nunca a senha da conta.
SMTP_USUARIO=
SMTP_SENHA=

# Endereço que aparece como remetente. É obrigatório junto com o SMTP_HOST —
# sem ele o envio fica desligado.
SMTP_REMETENTE=FinanCerto <naoresponda@seudominio.com>

# Endereço público desta instalação, usado para montar o link do e-mail.
# TROQUE PELO SEU: não há padrão embutido de propósito, porque o app é genérico
# e o domínio de quem escreveu o código não pode acabar no link de ninguém.
# NUNCA é deduzido do cabeçalho Host do pedido: um Host forjado mandaria o
# token de redefinição para o servidor de quem forjou.
APP_URL=https://financeiro.seudominio.com

# ---- Rede e cookie ----

# Ler o X-Forwarded-For para saber o IP de quem pede. Só ligue se houver mesmo
# um proxy na frente (Cloudflare, nginx): confiar nesse cabeçalho sem proxy
# deixa qualquer um trocar de IP a cada tentativa e escapar do limite de
# tentativas de login.
CONFIAR_EM_PROXY=

# Marcar o cookie de sessão como Secure (só trafega por HTTPS). Ligue quando o
# app só for alcançado por HTTPS — ligado num acesso por http://192.168.x.x o
# login para de funcionar, inclusive no app Android.
COOKIE_SEGURO=
