<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#141a21"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/app_name"
            android:textColor="#ffffff"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Só aparece quando o app fechou sozinho: é aqui que dá para ler o
             motivo e tirar um print, já que a tela principal é a que não abriu. -->
        <LinearLayout
            android:id="@+id/painelFalha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/painel_falha"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/falha_titulo"
                android:textColor="#ffab00"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/falha_explicacao"
                android:textColor="#919eab"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:id="@+id/textoFalha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#d6dde5"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/botaoDispensarFalha"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="@string/falha_dispensar"
                android:textColor="#919eab"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/setup_titulo"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_explicacao"
            android:textColor="#919eab"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.3"
            android:gravity="center" />

        <EditText
            android:id="@+id/campoServidor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:hint="@string/setup_placeholder"
            android:textColorHint="#6b7a87"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:padding="16dp"
            android:background="@drawable/campo_setup"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:maxLines="1"
            android:autofillHints="" />

        <TextView
            android:id="@+id/avisoSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="@drawable/aviso_setup"
            android:textColor="#ff5630"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/botaoConectar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/setup_conectar"
            android:textColor="#06231a"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#00a76f" />

        <!-- Testar não salva nada: serve pra descobrir onde está o problema
             quando conectar não dá certo, e pra confirmar que o endereço
             responde antes de entregar o celular pra outra pessoa. -->
        <Button
            android:id="@+id/botaoTestar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/setup_testar"
            android:textColor="#00a76f"
            android:textSize="15sp"
            android:background="@drawable/botao_contorno"
            android:backgroundTint="@null"
            android:stateListAnimator="@null" />

        <ProgressBar
            android:id="@+id/carregandoSetup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminateTint="#00a76f"
            android:visibility="gone" />

        <TextView
            android:id="@+id/resultadoTeste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:background="@drawable/painel_diagnostico"
            android:textColor="#d6dde5"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.25"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_dica"
            android:textColor="#6b7a87"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.35"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
