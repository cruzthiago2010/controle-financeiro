<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#141a21"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/app_name"
            android:textColor="#ffffff"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/setup_titulo"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_explicacao"
            android:textColor="#919eab"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.3"
            android:gravity="center" />

        <EditText
            android:id="@+id/campoServidor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:hint="@string/setup_placeholder"
            android:textColorHint="#6b7a87"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:padding="16dp"
            android:background="@drawable/campo_setup"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:maxLines="1"
            android:autofillHints="" />

        <TextView
            android:id="@+id/avisoSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="@drawable/aviso_setup"
            android:textColor="#ff5630"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/botaoConectar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/setup_conectar"
            android:textColor="#06231a"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#00a76f" />

        <ProgressBar
            android:id="@+id/carregandoSetup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminateTint="#00a76f"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_dica"
            android:textColor="#6b7a87"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.35"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
