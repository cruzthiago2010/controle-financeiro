# Qualquer variante do .env: cópia de segurança feita antes de mexer, .env.local,
# .env.producao. O `.env` sozinho não cobria isso, e um `git add -A` levaria
# GOOGLE_CLIENT_SECRET e BRAPI_TOKEN para um repositório público. O .env.example
# é a exceção — ele não tem segredo nenhum e precisa ser versionado.
.env.*
!.env.example

# Analytics desta instalação — cada um usa o seu (veja static/analytics.js)
static/analytics.js

